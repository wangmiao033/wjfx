// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  password       String
  createdAt      DateTime        @default(now())
  files          SharedFile[]
  deliverRecords DeliverRecord[]
}

model DeliverRecord {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productName      String
  publisher        String   @default("")
  developer        String   @default("")
  pastProducts     String   @default("")
  productNode      String   @default("")
  productTypes     String   @default("[]")
  privacyPolicyUrl String   @default("")
  userAgreementUrl String   @default("")
  testAccounts     String   @default("[]")

  status           String   @default("draft")

  shareCode        String?
  downloadLink     String?
  extractPassword  String?
  pushMessage      String?
  packageFileName  String?
  packageFileSize  Int?
  attachments      String   @default("[]")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, updatedAt])
}

model SharedFile {
  id            String   @id @default(cuid())
  fileName      String
  fileSize      Int
  filePath      String   // 本地模式：文件名; Vercel模式：Blob URL
  mimeType      String
  shareCode     String   @unique
  password      String?  // 提取密码（可选）
  downloadCount Int      @default(0)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
