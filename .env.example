# ===========================================
# FileShare 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# ===========================================

# --- 数据库（Supabase PostgreSQL）---
# Supabase → Project Settings → Database → Connection string
# Transaction pooler (6543) 用于 DATABASE_URL，Session (5432) 用于 DIRECT_URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- NextAuth 认证 ---
# 生成随机密钥：openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel Blob 文件存储 ---
# Vercel Dashboard → Storage → Blob → 创建 Store → 复制 Token
BLOB_READ_WRITE_TOKEN=""

# --- Resend 邮件（注册验证码，可选）---
# 未配置时开发模式会在控制台显示验证码
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Cron 定时清理（可选）---
# Vercel Cron 调用 /api/cron/cleanup 时的 Bearer Token
CRON_SECRET=""
